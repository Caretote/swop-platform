{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "env": {
    "DATABASE_URL": "@swop_database_url",
    "ANTHROPIC_API_KEY": "@swop_anthropic_api_key",
    "NEXTAUTH_SECRET": "@swop_nextauth_secret",
    "NEXTAUTH_URL": "@swop_nextauth_url"
  },
  "crons": [
    {
      "path": "/api/cron/attrition",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/market-refresh",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 0 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
